# Copy to .env and fill in. Never commit .env.
# Development keys expire every 24h: https://developer.riotgames.com/
RIOT_API_KEY=
# Platform routing value for Account/Summoner/League lookups (euw1, eun1, na1, kr, ...)
RIOT_PLATFORM=euw1
# Optional: PostgreSQL instead of the default SQLite file in backend/data/
# DATABASE_URL=postgresql+psycopg://user:pass@127.0.0.1:5432/nexuspulse
# |dP(win)| between consecutive minutes that counts as an inflection point
NEXUSPULSE_INFLECTION_DELTA=0.08
# Seed a synthetic corpus + train on first start when no models exist (1/0)
NEXUSPULSE_AUTO_BOOTSTRAP=1
